discover:
  - name: kab on a single machine (CRIU)
    how: fmf
    test:
     - /tests/kab_criu

adjust:
    provision:
       - name: client
         how: connect
         guest: $@KAB_CLIENT_IP

       - name: server
         how: connect
         guest: $@KAB_SERVER_IP
    when: KAB_CLIENT_IP is defined and KAB_SERVER_IP is defined
